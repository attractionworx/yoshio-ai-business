{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extraction-execution.schema.json",
  "title": "extraction-execution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "executions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revisions"
        ],
        "properties": {
          "revisions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/execution"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "revision",
        "createdAt",
        "updatedAt",
        "state",
        "targetOffer",
        "documents",
        "inputArtifact",
        "requestHash",
        "fingerprint",
        "provider",
        "model",
        "configuration",
        "estimate",
        "approval",
        "startedAt",
        "endedAt",
        "attempt",
        "responseHash",
        "validatedArtifact",
        "plannedImport",
        "savedImport",
        "error",
        "unknownReason",
        "recoveryRequired",
        "budget"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "enum": [
            "prepared",
            "approved",
            "sending",
            "response_received",
            "validated",
            "import_saving",
            "import_save_failed",
            "succeeded",
            "failed_before_request",
            "failed_after_request",
            "unknown",
            "recovery_required"
          ]
        },
        "targetOffer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "kind",
              "versionLabel",
              "bodyHash",
              "bytes"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "asp_material",
                  "advertiser_material",
                  "user_provided"
                ]
              },
              "versionLabel": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "bodyHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "maxItems": 20
        },
        "inputArtifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "hash",
            "bytes"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "requestHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider": {
          "enum": [
            "fake",
            "openai"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "hash",
            "promptVersion",
            "promptHash",
            "schemaVersion",
            "schemaHash",
            "maxInputTokens",
            "maxOutputTokens",
            "inputMilliYenPerMillion",
            "outputMilliYenPerMillion",
            "timeoutMs"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "promptVersion": {
              "type": "string"
            },
            "promptHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "schemaVersion": {
              "const": 1
            },
            "schemaHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "maxInputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "maxOutputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "inputMilliYenPerMillion": {
              "type": "integer",
              "minimum": 0
            },
            "outputMilliYenPerMillion": {
              "type": "integer",
              "minimum": 0
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputBytes",
            "inputTokens",
            "estimatedMilliYen",
            "maximumReservedMilliYen"
          ],
          "properties": {
            "inputBytes": {
              "type": "integer",
              "minimum": 0
            },
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "estimatedMilliYen": {
              "type": "integer",
              "minimum": 0
            },
            "maximumReservedMilliYen": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "approval": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "at",
                "hash",
                "revision"
              ],
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "revision": {
                  "const": 1
                }
              }
            }
          ]
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "endedAt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "attempt": {
          "enum": [
            "not_started",
            "may_have_started",
            "response_received"
          ]
        },
        "responseHash": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "validatedArtifact": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "hash",
                "bytes"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "plannedImport": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "contentHash"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "contentHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        },
        "savedImport": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision",
                "hash"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "revision": {
                  "const": 1
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "phase"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "phase": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "unknownReason": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "recoveryRequired": {
          "type": "boolean"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "month",
            "reservedMilliYen",
            "bookedMilliYen",
            "usage"
          ],
          "properties": {
            "state": {
              "enum": [
                "none",
                "reserved",
                "settled",
                "unknown"
              ]
            },
            "month": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "reservedMilliYen": {
              "type": "integer",
              "minimum": 0
            },
            "bookedMilliYen": {
              "type": "integer",
              "minimum": 0
            },
            "usage": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "inputTokens",
                    "outputTokens"
                  ],
                  "properties": {
                    "inputTokens": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "outputTokens": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "fake"
              }
            }
          },
          "then": {
            "properties": {
              "model": {
                "const": "fake-extraction-v1"
              }
            }
          }
        }
      ]
    }
  },
  "description": "Structural contract. Semantic hashes, evidence, money, states and history are strictly validated by the corresponding pure JavaScript validator; this schema alone grants no execution or human verification."
}
