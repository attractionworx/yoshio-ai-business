      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        "blockId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "description": "連続原文を完全転記。trim、正規化、訂正、要約、引用符追加は禁止。反復する短い引用を避け、一意な原文を選ぶ。start/endは出力しない。"
        }
      },
      "description": "指定documentの指定block内で一意に完全一致する連続原文quote。位置はローカルで決定する。"
    },
