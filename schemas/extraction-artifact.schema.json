{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extraction-artifact.schema.json",
  "title": "extraction-artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "executionId",
    "type",
    "createdAt",
    "contentHash",
    "byteSize",
    "content"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "input",
        "validated_extraction"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "byteSize": {
      "type": "integer",
      "minimum": 0
    },
    "content": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetOffer",
            "documents"
          ],
          "properties": {
            "targetOffer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "documents": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "offer-import.schema.json#/$defs/document"
              },
              "maxItems": 20
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputHash",
            "extraction"
          ],
          "properties": {
            "inputHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "extraction": {
              "$ref": "regulation-extraction.schema.json"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "input"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetOffer",
              "documents"
            ],
            "properties": {
              "targetOffer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "revision"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "documents": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "offer-import.schema.json#/$defs/document"
                },
                "maxItems": 20
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "validated_extraction"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inputHash",
              "extraction"
            ],
            "properties": {
              "inputHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "extraction": {
                "$ref": "regulation-extraction.schema.json"
              }
            }
          }
        }
      }
    }
  ],
  "description": "Structural contract. Semantic hashes, evidence, money, states and history are strictly validated by the corresponding pure JavaScript validator; this schema alone grants no execution or human verification."
}
