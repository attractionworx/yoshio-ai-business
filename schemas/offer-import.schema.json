{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "createdAt",
    "updatedAt",
    "targetOffer",
    "documents",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "format": "date-time"
    },
    "targetOffer": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "format": "uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OfferImportDraftV1",
  "description": "Independent review contract. Not an offer or an API execution/publication permission.",
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "format",
        "label",
        "kind",
        "versionLabel",
        "text",
        "textHash",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        "format": {
          "enum": [
            "text"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "kind": {
          "enum": [
            "asp_material",
            "advertiser_material",
            "user_provided"
          ]
        },
        "versionLabel": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            }
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "textHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "original",
        "review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        "original": {
          "$ref": "#/$defs/payload"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "edited",
        "verification",
        "reviewedAt",
        "checkedAt",
        "confirmedHash",
        "reason"
      ],
      "properties": {
        "decision": {
          "enum": [
            "pending",
            "accepted",
            "rejected"
          ]
        },
        "edited": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/payload"
            }
          ]
        },
        "verification": {
          "enum": [
            "unverified",
            "source_checked"
          ]
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "format": "date-time"
            }
          ]
        },
        "checkedAt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "format": "date-time"
            }
          ]
        },
        "confirmedHash": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "conversionKey",
        "category",
        "text",
        "usage",
        "purpose",
        "evidence"
      ],
      "properties": {
        "target": {
          "enum": [
            "name",
            "conversion_name",
            "disclosure_text",
            "facts",
            "targetAudience",
            "sellingPoints",
            "prohibitedExpressions",
            "eligibility",
            "approvalConditions",
            "rejectionConditions",
            "ctaLabel",
            "reward_evidence",
            "unmapped"
          ]
        },
        "conversionKey": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
            }
          ]
        },
        "category": {
          "enum": [
            "price",
            "track_record",
            "effect",
            "feature",
            "audience",
            "selling_point",
            "eligibility",
            "approval",
            "rejection",
            "prohibition",
            "reward",
            "other"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "usage": {
          "enum": [
            "publishable",
            "constraint_only",
            "internal_only"
          ]
        },
        "purpose": {
          "enum": [
            "fact",
            "restriction",
            "marketing_goal",
            "conversion_condition",
            "unmapped"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "blockId",
        "start",
        "end",
        "quote"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        "blockId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      }
    }
  }
}
